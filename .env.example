# Local API (used when VITE_INSTANCE_TYPE=LOCAL)
# Must include /api — backend routes are under /api/v1
VITE_API_URL_LOCAL=http://localhost:3000/api

# Production API (Netlify env) — MUST end with /api
# Correct:   https://crm-app-xwws.onrender.com/api
# Incorrect: https://crm-app-xwws.onrender.com
VITE_API_URL_PROD=https://crm-app-xwws.onrender.com/api

# LOCAL | PROD
# On Netlify: VITE_INSTANCE_TYPE=PROD (then redeploy — Vite bakes env at build time)
VITE_INSTANCE_TYPE=LOCAL
