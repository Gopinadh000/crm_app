# Server
APP_PORT=3000
# DEV | PROD  (required on Render/deploy: set APP_ENV=PROD)
APP_ENV=DEV

# ---------- Development DB (APP_ENV=DEV) ----------
APP_DB_DEV_HOST=localhost
APP_DB_DEV_PORT=3306
APP_DB_DEV_USER=root
APP_DB_DEV_PASSWORD=your_dev_db_password
APP_DB_DEV_NAME=app_crm

# ---------- Production DB (APP_ENV=PROD) ----------
# On Render/deploy set ONLY these (+ APP_ENV=PROD):
APP_DB_PROD_HOST=
APP_DB_PROD_PORT=3306
APP_DB_PROD_USER=
APP_DB_PROD_PASSWORD=
APP_DB_PROD_NAME=
# Use true for most cloud MySQL providers
APP_DB_PROD_SSL=false

# Auto-run SQL migrations on server start
# TRUE  -> apply pending scripts from src/db-scripts/migrations.sql
# FALSE -> skip migrations
AUTO_DB_MIGRATION=TRUE

# CORS — no trailing slash
# Local Vite
APP_CORS_ORIGIN_LOCAL=http://localhost:5174
# Production frontend (Netlify). Deploy previews like
# https://<id>--app-mini-crm.netlify.app are auto-allowed from this host.
APP_CORS_ORIGIN_PRODUCTION=https://app-mini-crm.netlify.app
# Optional: extra comma-separated origins
# APP_CORS_ORIGINS=http://localhost:5173,https://another-frontend.com

# JWT / Cookies
# In PROD cookies use SameSite=None; Secure=true (required for Netlify → API cross-site)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ACCESS_COOKIE_MS=900000
JWT_REFRESH_COOKIE_MS=604800000
