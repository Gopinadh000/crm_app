# Server
APP_PORT=3000
# DEV | PROD
APP_ENV=DEV

# ---------- Development DB (APP_ENV=DEV) ----------
APP_DB_DEV_HOST=localhost
APP_DB_DEV_PORT=3306
APP_DB_DEV_USER=root
APP_DB_DEV_PASSWORD=your_dev_db_password
APP_DB_DEV_NAME=app_crm

# ---------- Production DB (APP_ENV=PROD) ----------
# On deploy: set APP_ENV=PROD and fill these only
APP_DB_PROD_HOST=
APP_DB_PROD_PORT=3306
APP_DB_PROD_USER=
APP_DB_PROD_PASSWORD=
APP_DB_PROD_NAME=
APP_DB_PROD_SSL=false

# Auto-run SQL migrations on server start
# TRUE  -> apply pending scripts from src/db-scripts/migrations.sql
# FALSE -> skip migrations
AUTO_DB_MIGRATION=TRUE

# CORS
APP_CORS_ORIGIN_LOCAL=http://localhost:5174
APP_CORS_ORIGIN_PRODUCTION=https://your-frontend-domain.com

# JWT / Cookies
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ACCESS_COOKIE_MS=900000
JWT_REFRESH_COOKIE_MS=604800000
